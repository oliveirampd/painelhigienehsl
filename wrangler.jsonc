{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "painelhigienehsl",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TERMINAL_SYNC_DO",
        "class_name": "TerminalSyncDurableObject"
      }
    ]
  },
  "exports": {
    "TerminalSyncDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "VITE_SUPABASE_URL": "https://onhseaydchlxldoypqjg.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_aKe1HX_url7X52R1VitKJg_-g0HMSTf",
    "SUPABASE_URL": "https://onhseaydchlxldoypqjg.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_aKe1HX_url7X52R1VitKJg_-g0HMSTf"
  }
}